# Copy to .env and edit. Nothing here is a secret; a Hugging Face token (only for gated repos) is read from the environment (HF_TOKEN).
COMPOSE_PROFILES=gpu                     # gpu (Vulkan, /dev/dri), cpu (no GPU, CPU backend), chat (adds the chat model, class 04)
LLAMA_TAG=server-vulkan-b11243           # pinned llama.cpp build (Vulkan). Update deliberately, not with "latest".
EMBED_GGUF=nomic-embed-text-v2-moe.Q8_0.gguf
MINI_GGUF=all-MiniLM-L6-v2-ggml-model-f16.gguf   # download_model.py --repo second-state/All-MiniLM-L6-v2-Embedding-GGUF --quant f16
CHAT_GGUF=gemma-4-12b-it-Q4_K_M.gguf     # class 04 only: `download_model.py --repo unsloth/gemma-4-12b-it-GGUF --quant Q4_K_M` (7.1 GB)
EMBED_PORT=8080
MINI_PORT=8082
CHAT_PORT=8081
RENDER_GID=0                             # rootless Docker/Podman: numeric gid of the `render` or `video` group owning /dev/dri/renderD128
